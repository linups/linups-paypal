{
    "name": "linups/linups-paypal",
    "description": "Laravel wrapper for PayPal Orders v2 and Subscriptions API",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Linups"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Linups\\LinupsPaypal\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Linups\\LinupsPaypal\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Linups\\LinupsPaypal\\LinupsPaypalServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
